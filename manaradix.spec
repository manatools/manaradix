# Mageia RPM spec for manaradix
#
# Build with:  bm -sl manaradix.spec   (SRPM packaging, source-only)
# Validate with: iurt                  (clean-chroot build, the only build)
#
# No %%changelog -- Mageia builds the changelog from SVN/git commit messages.

%global pypi_name manaradix

Name:           manaradix
Version:        0.1.0
Release:        1%{?disttag}
Summary:        Btrfs snapshot, subvolume, and filesystem management utility

License:        GPLv2+
Group:          System/Configuration
URL:            https://github.com/mageia/manaradix
Source0:        %{name}-%{version}.tar.gz

BuildArch:      noarch

# Python build tools
BuildRequires:  python3-devel
BuildRequires:  python3-pip
BuildRequires:  python3-setuptools
BuildRequires:  python3-wheel

# Translations (msgfmt for .mo compilation)
BuildRequires:  gettext

# Runtime Python deps
BuildRequires:  python3dist(tomlkit) >= 0.12.0
Requires:       python3dist(tomlkit) >= 0.12.0

# System runtime deps (not strictly required at build time)
Requires:       btrfs-progs >= 6.7
Requires:       systemd >= 255
Requires:       polkit >= 0.120

# D-Bus daemon: bus bindings + polkit GI checks
Requires:       python3-dbus >= 1.2
Requires:       python3-gobject

# Optional: GUI (multi-frontend via python-manatools aui)
Suggests:       python3dist(manatools)

# Optional: boot-from-snapshot
Suggests:       grub2

%description
Manaradix is a system utility for Mageia providing a unified graphical,
text, and web interface for managing Btrfs snapshots, subvolumes, and
filesystem parameters.

Features:
  - Snapshot management (create, list, delete, restore, browse, export)
  - Automated snapshot policies via systemd timers
    (hourly/daily/weekly/monthly)
  - Boot-time snapshots
  - GRUB integration for booting from snapshots
  - Policy-based retention and pruning
  - Filesystem maintenance (scrub, balance, defrag, compression)
  - Multi-frontend support via the python-manatools aui backend
    (Qt, GTK, ncurses, Web)

%prep
%autosetup -n %{name}-%{version}

%build
%pyproject_wheel

%install
%pyproject_install

# --- Polkit policy ---
install -D -m 0644 data/polkit/org.mageia.manaradix.policy \
    %{buildroot}%{_datadir}/polkit-1/actions/org.mageia.manaradix.policy

# --- Desktop launcher ---
install -D -m 0644 data/desktop/manaradix.desktop \
    %{buildroot}%{_datadir}/applications/manaradix.desktop

# --- Setup wizard profiles (TOML templates) ---
install -d %{buildroot}%{_datadir}/manaradix/templates
cp -a data/templates/*.toml %{buildroot}%{_datadir}/manaradix/templates/

# --- Logo (SVG for the window icon, PNG raster for the About page) ---
install -D -m 0644 data/images/manaradix.svg \
    %{buildroot}%{_datadir}/manaradix/images/manaradix.svg
install -D -m 0644 data/images/manaradix.png \
    %{buildroot}%{_datadir}/manaradix/images/manaradix.png

# --- D-Bus service: unit + bus-activation + bus policy ---
# Bus-activated on demand; deliberately NOT enabled at boot.
install -D -m 0644 data/systemd/manaradix-dbus.service \
    %{buildroot}%{_unitdir}/manaradix-dbus.service
install -D -m 0644 data/dbus/org.mageia.manaradix.service \
    %{buildroot}%{_datadir}/dbus-1/system-services/org.mageia.manaradix.service
install -D -m 0644 data/dbus/org.mageia.manaradix.conf \
    %{buildroot}%{_sysconfdir}/dbus-1/system.d/org.mageia.manaradix.conf

# --- Locale files (translations ship as .mo, compiled from .po) ---
install -d %{buildroot}%{_datadir}/locale/it/LC_MESSAGES
msgfmt -o %{buildroot}%{_datadir}/locale/it/LC_MESSAGES/manaradix.mo \
    locale/it.po
%find_lang %{name}

%files -f %{name}.lang
%license LICENSE
%doc README.md
%{_bindir}/manaradix
%{python3_sitelib}/manaradix/
%{python3_sitelib}/manaradix-%{version}*.dist-info/
%{_datadir}/polkit-1/actions/org.mageia.manaradix.policy
%{_datadir}/applications/manaradix.desktop
%{_datadir}/manaradix/templates/
%{_datadir}/manaradix/images/
%{_unitdir}/manaradix-dbus.service
%{_datadir}/dbus-1/system-services/org.mageia.manaradix.service
%config(noreplace) %{_sysconfdir}/dbus-1/system.d/org.mageia.manaradix.conf

%post
# Polkit: reload policy definitions
%{_bindir}/pkcheck --action-id org.mageia.manaradix.read \
    --process $$ 2>/dev/null || true

# D-Bus: pick up the new unit and the bus policy (system.d is read at
# bus start/reload only; the unit is never enabled — activation comes
# from the system-services file).
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || true
%{_bindir}/systemctl reload dbus >/dev/null 2>&1 || \
    %{_bindir}/systemctl reload dbus-broker >/dev/null 2>&1 || true

%preun
# Clean up any systemd units generated by the user's policies
if [ "$1" -eq 0 ]; then
    for unit in %{_unitdir}/manaradix-snapshot-*.timer \
                %{_unitdir}/manaradix-snapshot-*.service; do
        [ -f "$unit" ] || continue
        %{_bindir}/systemctl stop "$(basename "$unit")" 2>/dev/null || true
        %{_bindir}/systemctl disable "$(basename "$unit")" 2>/dev/null || true
    done
    %{_bindir}/systemctl stop manaradix-dbus.service 2>/dev/null || true
fi

%postun
# Runs on upgrade and erasure (the bus policy may already be gone).
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || true
%{_bindir}/systemctl reload dbus >/dev/null 2>&1 || \
    %{_bindir}/systemctl reload dbus-broker >/dev/null 2>&1 || true
