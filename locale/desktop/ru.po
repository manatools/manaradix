#: data/desktop/manaradix-tray.desktop
msgctxt "Name"
msgid "Manaradix Tray"
msgstr "Трей Manaradix"

#: data/desktop/manaradix-tray.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Health Monitor"
msgstr "Монитор состояния снимков Btrfs"

#: data/desktop/manaradix-tray.desktop
msgctxt "Comment"
msgid ""
"Monitor disk space, device health, and snapshot retention from the system "
"tray"
msgstr ""
"Отслеживание места на диске, состояния устройства и сохранения снимков из "
"системного трея"

#: data/desktop/manaradix-tray.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr "btrfs;snapshot;tray;notification;health;disk;снимок;трей;уведомление;состояние;диск;"

#: data/desktop/org.mageia.manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/org.mageia.manaradix.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Manager"
msgstr "Менеджер снимков Btrfs"

#: data/desktop/org.mageia.manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr "Управление снимками, подтомами и параметрами файловой системы Btrfs"

#: data/desktop/org.mageia.manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
msgstr ""
