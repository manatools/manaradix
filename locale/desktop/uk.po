#: data/desktop/manaradix-tray.desktop
msgctxt "Name"
msgid "Manaradix Tray"
msgstr "Лоток Manaradix"

#: data/desktop/manaradix-tray.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Health Monitor"
msgstr "Монітор стану знімків Btrfs"

#: data/desktop/manaradix-tray.desktop
msgctxt "Comment"
msgid ""
"Monitor disk space, device health, and snapshot retention from the system "
"tray"
msgstr ""
"Стеження з місцем на диску, стан пристрою та збереження знімків з системного "
"лотка"

#: data/desktop/manaradix-tray.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr ""
"btrfs;snapshot;tray;notification;health;disk;бтрфс;знімок;лоток;сповіщення;ст"
"ан;диск;"

#: data/desktop/manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/manaradix.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Manager"
msgstr "Керування знімками Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr "Керування знімками, підтомами та параметрами файлової системи Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
msgstr ""
"btrfs;snapshot;subvolume;filesystem;backup;restore;бтрфс;знімок;підтом;файлов"
"а система;резервна копія;відновлення;"
