#: data/desktop/manaradix-tray.desktop
msgctxt "Name"
msgid "Manaradix Tray"
msgstr "Manaradix Tray"

#: data/desktop/manaradix-tray.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Health Monitor"
msgstr "Monitor dello stato degli snapshot Btrfs"

#: data/desktop/manaradix-tray.desktop
msgctxt "Comment"
msgid ""
"Monitor disk space, device health, and snapshot retention from the system "
"tray"
msgstr ""
"Controlla spazio su disco, salute dei dispositivi e conservazione degli "
"snapshot dalla barra di sistema"

#: data/desktop/manaradix-tray.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr "btrfs;snapshot;barra di sistema;notifica;salute;disco;"

#: data/desktop/manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/manaradix.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Manager"
msgstr "Gestore degli snapshot Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr "Gestisci snapshot, subvolume e parametri del filesystem Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
msgstr "btrfs;snapshot;subvolume;filesystem;backup;ripristino;"
