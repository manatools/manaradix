#: data/desktop/manaradix-tray.desktop
msgctxt "Name"
msgid "Manaradix Tray"
msgstr "Manaradix Systeemvak"

#: data/desktop/manaradix-tray.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Health Monitor"
msgstr "Btrfs Snapshot Gezondheids-monitor"

#: data/desktop/manaradix-tray.desktop
msgctxt "Comment"
msgid ""
"Monitor disk space, device health, and snapshot retention from the system "
"tray"
msgstr ""
"Houd schijfruimte, apparaatstatus en het behoud van snapshots in de gaten "
"vanuit het systeemvak"

#: data/desktop/manaradix-tray.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr "btrfs;snapshot;tray;notification;health;disk;"

#: data/desktop/manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/manaradix.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Manager"
msgstr "Btrfs Snapshot Beheer"

#: data/desktop/manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr "Beheer Btrfs snapshots, subvolumes, and bestandssysteem parameters"

#: data/desktop/manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
msgstr "btrfs;snapshot;subvolume;filesystem;backup;restore;"
