#: data/desktop/manaradix-tray.desktop
msgctxt "Name"
msgid "Manaradix Tray"
msgstr "Safata del Manaradix"

#: data/desktop/manaradix-tray.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Health Monitor"
msgstr "Monitoratge de l'estat de les instantànies Btrfs"

#: data/desktop/manaradix-tray.desktop
msgctxt "Comment"
msgid ""
"Monitor disk space, device health, and snapshot retention from the system "
"tray"
msgstr ""
"Monitoreu l'espai en disc, l'estat del dispositiu i la retenció de les "
"instantànies des de la safata del sistema."

#: data/desktop/manaradix-tray.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr "btrfs;instantània;safata;notificació;estat;disc;"

#: data/desktop/manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/manaradix.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Manager"
msgstr "Gestor d'instantànies de Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr ""
"Gestioneu instantànies, subvolums i paràmetres del sistema de fitxers Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
msgstr ""
"btrfs;instantània;subvolum;sistema de fitxers;còpia de "
"seguretat;restauració;"
