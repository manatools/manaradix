msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr "btrfs;快照;托盘;通知;健康;磁盘;"

#: data/desktop/manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/manaradix.desktop
