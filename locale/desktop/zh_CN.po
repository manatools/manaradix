msgstr "Btrfs 快照管理器"

#: data/desktop/manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr "管理 Btrfs 快照、子卷和文件系统参数"

#: data/desktop/manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
