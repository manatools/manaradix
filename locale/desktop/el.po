#: data/desktop/manaradix-tray.desktop
msgctxt "Name"
msgid "Manaradix Tray"
msgstr "Manaradix στο πλαίσιο συστήματος"

#: data/desktop/manaradix-tray.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Health Monitor"
msgstr "Παρακολούθηση υγείας στιγμιοτύπων Btrfs"

#: data/desktop/manaradix-tray.desktop
msgctxt "Comment"
msgid ""
"Monitor disk space, device health, and snapshot retention from the system "
"tray"
msgstr ""
"Παρακολούθηση του χώρου στον δίσκο, της υγείας των συσκευών και της "
"διατήρησης στιγμιοτύπων από το πλαίσιο συστήματος"

#: data/desktop/manaradix-tray.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;tray;notification;health;disk;"
msgstr "btrfs;στιγμιότυπο;πλαίσιο συστήματος;ειδοποίηση;υγεία;δίσκος;"

#: data/desktop/manaradix.desktop
msgctxt "Name"
msgid "Manaradix"
msgstr "Manaradix"

#: data/desktop/manaradix.desktop
msgctxt "GenericName"
msgid "Btrfs Snapshot Manager"
msgstr "Διαχειριστής στιγμιοτύπων Btrfs"

#: data/desktop/manaradix.desktop
msgctxt "Comment"
msgid "Manage Btrfs snapshots, subvolumes, and filesystem parameters"
msgstr ""
"Διαχείριση στιγμιοτύπων Btrfs, υποτόμων και παραμέτρων του συστήματος "
"αρχείων"

#: data/desktop/manaradix.desktop
msgctxt "Keywords"
msgid "btrfs;snapshot;subvolume;filesystem;backup;restore;"
msgstr ""
"btrfs;στιγμιότυπο;υποτόμος;σύστημα αρχείων;αντίγραφα ασφαλείας;επαναφορά;"
