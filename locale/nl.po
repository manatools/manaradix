msgstr "Schijfruimte kritiek op %s"

#: manaradix/core/health.py:177
#, python-format
msgid "%(percent)d%% of %(total)s used, only %(free)s free"
msgstr "%(percent)d%% van %(total)s gebruikt, slechts %(free)s vrij"

