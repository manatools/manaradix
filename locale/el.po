#: manaradix/module.py:298
#, python-format
msgid "Path to config file (default: %(default)s)"
msgstr "Διαδρομή του αρχείου διαμόρφωσης (εξ ορισμού: %(default)s)"

#: manaradix/module.py:631
#, python-format
msgid "Created snapshot: %s"
msgstr "Δημιουργήθηκε το στιγμιότυπο: %s"

#: manaradix/module.py:632
#, python-format
msgid "  Subvolume:   %s"
msgstr "  Υποτόμος:        %s"

#: manaradix/module.py:633
#, python-format
msgid "  Path:        %s"
msgstr "  Διαδρομή:        %s"

#: manaradix/module.py:634
#, python-format
msgid "  Type:        %s"
msgstr "  Τύπος:           %s"

#: manaradix/module.py:636
#, python-format
msgid "  Schedule:    %s"
msgstr "  Προγραμματισμός: %s"

#: manaradix/module.py:638
#, python-format
msgid "  Description: %s"
msgstr "  Περιγραφή:       %s"

#: manaradix/module.py:695
msgid "No snapshots found."
msgstr "Δεν βρέθηκαν στιγμιότυπα."

#: manaradix/module.py:727
#, python-format
msgid "Deleted snapshot: %s"
msgstr "Διαγράφηκε το στιγμιότυπο: %s"

#: manaradix/module.py:767
#, python-format
msgid "[DRY RUN] Would delete %d snapshot(s):"
msgstr "[ΔΟΚΙΜΑΣΤΙΚΗ ΕΚΤΕΛΕΣΗ] Θα διαγράφονταν %d στιγμιότυπα:"

#: manaradix/module.py:771
#, python-format
msgid "[DRY RUN] Nothing to prune (%d kept, 0 excess)."
msgstr ""
"[ΔΟΚΙΜΑΣΤΙΚΗ ΕΚΤΕΛΕΣΗ] Δεν υπάρχουν στιγμιότυπα προς εκκαθάριση "
"(διατηρούνται %d, δεν υπάρχει πλεόνασμα)."

#: manaradix/module.py:773
#, python-format
msgid "Pruned %d snapshot(s):"
msgstr "Εκκαθαρίστηκαν %d στιγμιότυπα:"

#: manaradix/module.py:777
#, python-format
msgid "Nothing to prune (%d kept, no excess)."
msgstr ""
"Δεν υπάρχουν στιγμιότυπα προς εκκαθάριση (διατηρούνται %d, δεν υπάρχει "
"πλεόνασμα)."

#: manaradix/module.py:792
msgid "Setup not needed: snapshots or policies already exist."
msgstr "Δεν απαιτείται αρχική ρύθμιση: υπάρχουν ήδη στιγμιότυπα ή πολιτικές."

#: manaradix/module.py:797
msgid "Setup needed, but no btrfs filesystem was found on this system."
msgstr ""
"Απαιτείται αρχική ρύθμιση, αλλά δεν βρέθηκε σύστημα αρχείων btrfs σε αυτό το"
" σύστημα."

#: manaradix/module.py:802
msgid "Setup needed: no snapshots and no snapshot policies are configured."
msgstr ""
"Απαιτείται αρχική ρύθμιση: δεν έχουν διαμορφωθεί στιγμιότυπα ή πολιτικές "
"στιγμιοτύπων."

#: manaradix/module.py:803
#, python-format
msgid "Detected role: %s"
msgstr "Εντοπίστηκε ο ρόλος: %s"

#: manaradix/module.py:805 manaradix/module.py:853
#: manaradix/core/setup_wizard.py:263 manaradix/ui/pages/setup.py:90
msgid "No setup profiles are available on this system."
msgstr "Δεν υπάρχουν διαθέσιμα προφίλ αρχικής ρύθμισης σε αυτό το σύστημα."

#: manaradix/module.py:807
#, python-format
msgid "Default profile: %s"
msgstr "Εξ ορισμού προφίλ: %s"

#: manaradix/module.py:808
msgid "Run 'manaradix setup apply' to apply it."
msgstr "Εκτελέστε την εντολή 'manaradix setup apply' για να το εφαρμόσετε."

#: manaradix/module.py:823
#, python-format
msgid "[DRY RUN] Would apply the setup profile %s:"
msgstr "[ΔΟΚΙΜΑΣΤΙΚΗ ΕΚΤΕΛΕΣΗ] Θα εφαρμοζόταν το προφίλ αρχικής ρύθμισης %s:"

#: manaradix/module.py:825
#, python-format
msgid "Applied the setup profile %s:"
msgstr "Εφαρμόστηκε το προφίλ αρχικής ρύθμισης %s:"

#: manaradix/module.py:830
#, python-format
msgid "  %s: %s (retention: %s)"
msgstr "  %s: %s (διατήρηση: %s)"

#: manaradix/module.py:837
msgid "would be installed"
msgstr "θα γινόταν εγκατάσταση"

#: manaradix/module.py:839
msgid "not available"
msgstr "δεν είναι διαθέσιμο"

#: manaradix/module.py:842 manaradix/ui/pages/settings.py:190
#: manaradix/ui/pages/setup.py:271
msgid "installed"
msgstr "εγκατεστημένο"

#: manaradix/module.py:842 manaradix/ui/pages/settings.py:190
#: manaradix/ui/pages/setup.py:271
msgid "not installed"
msgstr "δεν είναι εγκατεστημένο"

#: manaradix/module.py:843
#, python-format
msgid "  GRUB recovery menu: %s"
msgstr "  Μενού ανάκτησης GRUB: %s"

#: manaradix/module.py:856
msgid "Available setup profiles:"
msgstr "Διαθέσιμα προφίλ αρχικής ρύθμισης:"

#: manaradix/module.py:879
msgid "No activities are configured."
msgstr "Δεν έχουν διαμορφωθεί δραστηριότητες."

#: manaradix/module.py:882
msgid "Activity status:"
msgstr "Κατάσταση δραστηριοτήτων:"

#: manaradix/module.py:886 manaradix/ui/pages/dashboard.py:513
#: manaradix/ui/pages/triggers.py:313
msgid "never"
msgstr "ποτέ"

#: manaradix/module.py:888 manaradix/ui/pages/dashboard.py:515
#: manaradix/ui/pages/triggers.py:316
#, python-format
msgid "%s (%s)"
msgstr "%s (%s)"

#: manaradix/module.py:946
msgid "The manaradix D-Bus service is running."
msgstr "Η υπηρεσία D-Bus του manaradix εκτελείται."

#: manaradix/module.py:950
msgid ""
"The manaradix D-Bus service is not running; it starts automatically on first"
" use."
msgstr ""
"Η υπηρεσία D-Bus του manaradix δεν εκτελείται. Ξεκινά αυτόματα κατά την "
"πρώτη χρήση."

#: manaradix/module.py:969
msgid "The manaradix tray applet is running."
msgstr "Η μικροεφαρμογή του manaradix στο πλαίσιο συστήματος εκτελείται."

#: manaradix/module.py:973
msgid ""
"The manaradix tray applet is not running; it starts automatically at login."
msgstr ""
"Η μικροεφαρμογή του manaradix στο πλαίσιο συστήματος δεν εκτελείται. Ξεκινά "
"αυτόματα κατά τη σύνδεση."

#: manaradix/module.py:1021
#, python-format
msgid "Status: %s"
msgstr "Κατάσταση: %s"

#: manaradix/module.py:1023
#, python-format
msgid "Last started: %s"
msgstr "Τελευταία έναρξη: %s"

#: manaradix/module.py:1025
#, python-format
msgid "Last finished: %s"
msgstr "Τελευταία ολοκλήρωση: %s"

#: manaradix/module.py:1027
#, python-format
msgid "Last error: %s"
msgstr "Τελευταίο σφάλμα: %s"

#: manaradix/module.py:1038
msgid "No usage data available. Run 'manaradix usage collect' first."
msgstr ""
"Δεν υπάρχουν διαθέσιμα δεδομένα χρήσης. Εκτελέστε πρώτα την εντολή "
"'manaradix usage collect'."

#: manaradix/module.py:1041
msgid "Snapshot disk usage (last collected):"
msgstr "Χρήση δίσκου από στιγμιότυπα (τελευταία συλλογή δεδομένων):"

#: manaradix/module.py:1076
#, python-format
msgid "ID:          %s"
msgstr "Αναγνωριστικό:     %s"

#: manaradix/module.py:1077
#, python-format
msgid "Subvolume:   %s"
msgstr "Υποτόμος:          %s"

#: manaradix/module.py:1078
#, python-format
msgid "Path:        %s"
msgstr "Διαδρομή:          %s"

#: manaradix/module.py:1079
#, python-format
msgid "Date:        %s"
msgstr "Ημερομηνία:        %s"

#: manaradix/module.py:1080
#, python-format
msgid "Type:        %s"
msgstr "Τύπος:             %s"

#: manaradix/module.py:1081
#, python-format
msgid "Read-only:   %s"
msgstr "Μόνο για ανάγνωση: %s"

#: manaradix/module.py:1082
#, python-format
msgid "Schedule:    %s"
msgstr "Προγραμματισμός:   %s"

#: manaradix/module.py:1083
#, python-format
msgid "Description: %s"
msgstr "Περιγραφή:         %s"

#: manaradix/utils/pkexec.py:152
#, python-format
msgid ""
"error: %s not found. Install polkit to use privileged manaradix commands."
msgstr ""
"σφάλμα: δεν βρέθηκε το %s. Εγκαταστήστε το polkit για να χρησιμοποιήσετε "
"εντολές του manaradix με αυξημένα δικαιώματα."

#: manaradix/utils/pkexec.py:158
#, python-format
msgid "error: pkexec failed: %s"
msgstr "σφάλμα: αποτυχία του pkexec: %s"

#: manaradix/core/health.py:175
#, python-format
msgid "Disk space critical on %s"
msgstr "Κρίσιμη έλλειψη χώρου στο %s"

#: manaradix/core/health.py:177
#, python-format
msgid "%(percent)d%% of %(total)s used, only %(free)s free"
msgstr ""
"Χρησιμοποιείται το %(percent)d%% από %(total)s, απομένουν μόνο %(free)s "
"ελεύθερα"

#: manaradix/core/health.py:180
#, python-format
msgid "Disk space low on %s"
msgstr "Λίγος διαθέσιμος χώρος στο %s"

#: manaradix/core/health.py:182
#, python-format
msgid "%(percent)d%% of %(total)s used, %(free)s free"
msgstr ""
"Χρησιμοποιείται το %(percent)d%% από %(total)s, απομένουν %(free)s ελεύθερα"

#: manaradix/core/health.py:191
msgid "Free some space, or let the retention profile prune old snapshots."
msgstr ""
"Ελευθερώστε χώρο ή αφήστε το προφίλ διατήρησης να εκκαθαρίσει τα παλιά "
"στιγμιότυπα."

#: manaradix/core/health.py:224
#, python-format
msgid "Data integrity errors on %s"
msgstr "Σφάλματα ακεραιότητας δεδομένων στο %s"

#: manaradix/core/health.py:226
#, python-format
msgid ""
"%(corruption)d corruption, %(generation)d generation errors recorded by "
"btrfs."
msgstr ""
"Το btrfs κατέγραψε %(corruption)d σφάλματα αλλοίωσης και %(generation)d "
"σφάλματα γενιάς."

#: manaradix/core/health.py:230
msgid "Check the device and restore from the newest good snapshot."
msgstr ""
"Ελέγξτε τη συσκευή και επαναφέρετε τα δεδομένα από το πιο πρόσφατο έγκυρο "
"στιγμιότυπο."

#: manaradix/core/health.py:240
#, python-format
msgid "IO errors on %s"
msgstr "Σφάλματα εισόδου/εξόδου στο %s"

#: manaradix/core/health.py:242
#, python-format
msgid ""
"%(write)d write, %(read)d read, %(flush)d flush errors recorded by btrfs."
msgstr ""
"Το btrfs κατέγραψε %(write)d σφάλματα εγγραφής, %(read)d ανάγνωσης και "
"%(flush)d εκκένωσης."

#: manaradix/core/health.py:247
msgid "Inspect the device, cabling, and enclosure."
msgstr "Ελέγξτε τη συσκευή, την καλωδίωση και το περίβλημα."

#: manaradix/core/health.py:258
#, python-format
msgid "SMART health failing on %s"
msgstr "Ο έλεγχος SMART αναφέρει βλάβη στο %s"

#: manaradix/core/health.py:259
msgid "The drive reports an imminent failure.  Back up your data now."
msgstr ""
"Ο δίσκος αναφέρει επικείμενη βλάβη. Δημιουργήστε τώρα αντίγραφα ασφαλείας "
"των δεδομένων σας."

#: manaradix/core/health.py:261
msgid "Replace the drive as soon as possible."
msgstr "Αντικαταστήστε τον δίσκο το συντομότερο δυνατό."

#: manaradix/core/health.py:271
#, python-format
msgid "Drive running hot on %s"
msgstr "Υψηλή θερμοκρασία δίσκου στο %s"

#: manaradix/core/health.py:272
#, python-format
msgid "The drive is at %(temp)d °C."
msgstr "Η θερμοκρασία του δίσκου είναι %(temp)d °C."

#: manaradix/core/health.py:275
msgid "Check airflow and cooling."
msgstr "Ελέγξτε τη ροή αέρα και την ψύξη."

#: manaradix/core/health.py:305
msgid "Scrub found errors"
msgstr "Ο έλεγχος ακεραιότητας εντόπισε σφάλματα"

#: manaradix/core/health.py:306
#, python-format
msgid "%d errors were found by the last scrub."
msgstr "Εντοπίστηκαν %d σφάλματα κατά τον τελευταίο έλεγχο ακεραιότητας."

#: manaradix/core/health.py:307
msgid "Run a new scrub and inspect the devices."
msgstr "Εκτελέστε νέο έλεγχο ακεραιότητας και ελέγξτε τις συσκευές."

#: manaradix/core/health.py:319
msgid "Scrub appears stuck"
msgstr "Ο έλεγχος ακεραιότητας φαίνεται να μην προχωρά"

#: manaradix/core/health.py:321
#, python-format
msgid "The scrub has been running for more than %d hours."
msgstr "Ο έλεγχος ακεραιότητας εκτελείται για περισσότερες από %d ώρες."

#: manaradix/core/health.py:323
msgid "Check the scrub progress in the GUI."
msgstr "Ελέγξτε την πρόοδο του ελέγχου ακεραιότητας στη γραφική διεπαφή."

#: manaradix/core/health.py:333
msgid "No scrub recorded"
msgstr "Δεν έχει καταγραφεί έλεγχος ακεραιότητας"

#: manaradix/core/health.py:335
msgid ""
"No scrub run is recorded.  Regular scrubs catch bit-rot on long-lived "
"servers."
msgstr ""
"Δεν έχει καταγραφεί εκτέλεση ελέγχου ακεραιότητας. Οι τακτικοί έλεγχοι "
"ακεραιότητας εντοπίζουν τη σταδιακή αλλοίωση δεδομένων σε διακομιστές με "
"μακροχρόνια λειτουργία."

#: manaradix/core/health.py:338
msgid "Run a scrub now and schedule it regularly."
msgstr ""
"Εκτελέστε τώρα έναν έλεγχο ακεραιότητας και προγραμματίστε την τακτική "
"εκτέλεσή του."

#: manaradix/core/health.py:347
msgid "Last scrub is stale"
msgstr "Έχει περάσει πολύς καιρός από τον τελευταίο έλεγχο ακεραιότητας"

#: manaradix/core/health.py:349
#, python-format
msgid "The last scrub is %d days old; run a new one."
msgstr ""
"Ο τελευταίος έλεγχος ακεραιότητας έγινε πριν από %d ημέρες. Εκτελέστε έναν "
"νέο."

#: manaradix/core/health.py:351
msgid "Run a scrub now."
msgstr "Εκτελέστε τώρα έναν έλεγχο ακεραιότητας."

#: manaradix/core/health.py:440
#, python-format
msgid "Too many %(tier)s snapshots on %(subvol)s"
msgstr "Υπερβολικά πολλά στιγμιότυπα κατηγορίας %(tier)s στο %(subvol)s"

#: manaradix/core/health.py:444
#, python-format
msgid "%(count)d snapshots kept, retention caps at %(cap)d."
msgstr ""
"Διατηρούνται %(count)d στιγμιότυπα, ενώ το όριο διατήρησης είναι %(cap)d."

#: manaradix/core/health.py:446
msgid "Delete the oldest ones, or adjust the retention on the Policies page."
msgstr ""
"Διαγράψτε τα παλαιότερα ή προσαρμόστε τη διατήρηση στη σελίδα «Πολιτικές»."

#: manaradix/core/health.py:460
#, python-format
msgid "Too many snapshots on %s (kiosk)"
msgstr "Υπερβολικά πολλά στιγμιότυπα στο %s (τερματικό ειδικής χρήσης)"

#: manaradix/core/health.py:462
#, python-format
msgid "Kiosk profiles keep at most %(max)d snapshots; %(count)d exist."
msgstr ""
"Τα προφίλ τερματικών ειδικής χρήσης διατηρούν το πολύ %(max)d στιγμιότυπα. "
"Υπάρχουν %(count)d."

#: manaradix/core/health.py:465
msgid "Delete the oldest snapshots and keep the last good state."
msgstr ""
"Διαγράψτε τα παλαιότερα στιγμιότυπα και διατηρήστε την τελευταία έγκυρη "
"κατάσταση."

#: manaradix/core/health.py:479
#, python-format
msgid "Free space below %d%% on %s"
msgstr "Ελεύθερος χώρος κάτω από %d%% στο %s"

#: manaradix/core/health.py:483
msgid "The kiosk is nearly full; new snapshots may fail."
msgstr ""
"Ο χώρος αποθήκευσης του τερματικού ειδικής χρήσης έχει σχεδόν εξαντληθεί. Η "
"δημιουργία νέων στιγμιοτύπων ενδέχεται να αποτύχει."

#: manaradix/core/health.py:485
msgid "Consider pausing the hourly and daily snapshot schedules."
msgstr ""
"Εξετάστε το ενδεχόμενο παύσης της ωριαίας και της ημερήσιας δημιουργίας "
"στιγμιοτύπων."

#: manaradix/core/health.py:505
#, python-format
msgid "%(tier)s snapshots older than %(days)d days on %(subvol)s"
msgstr ""
"Στιγμιότυπα κατηγορίας %(tier)s παλαιότερα των %(days)d ημερών στο "
"%(subvol)s"

#: manaradix/core/health.py:511
#, python-format
msgid "%(count)d snapshots, oldest from %(date)s."
msgstr "%(count)d στιγμιότυπα, το παλαιότερο με ημερομηνία %(date)s."

#: manaradix/core/health.py:513
msgid "Delete the old ones, or extend the retention policy."
msgstr ""
"Διαγράψτε τα παλιά ή παρατείνετε την περίοδο διατήρησης στην πολιτική."

#: manaradix/core/setup_wizard.py:179 manaradix/core/setup_wizard.py:205
msgid "Boot snapshots are not available: the root filesystem is not btrfs."
msgstr ""
"Δεν διατίθενται στιγμιότυπα κατά την εκκίνηση: το ριζικό σύστημα αρχείων δεν"
" είναι btrfs."

#: manaradix/core/setup_wizard.py:185 manaradix/ui/pages/setup.py:208
#: manaradix/ui/pages/setup.py:232
msgid "Not available on this system"
msgstr "Δεν είναι διαθέσιμο σε αυτό το σύστημα"

#: manaradix/core/setup_wizard.py:211
msgid ""
"The GRUB recovery menu is not available: it needs a btrfs root filesystem "
"and GRUB."
msgstr ""
"Το μενού ανάκτησης GRUB δεν είναι διαθέσιμο: απαιτεί ριζικό σύστημα αρχείων "
"btrfs και GRUB."

#: manaradix/core/setup_wizard.py:217
msgid ""
"Pre-upgrade snapshots are not available: the root filesystem is not btrfs."
msgstr ""
"Δεν διατίθενται στιγμιότυπα πριν από την αναβάθμιση: το ριζικό σύστημα "
"αρχείων δεν είναι btrfs."

#: manaradix/core/setup_wizard.py:258
#, python-format
msgid "Unknown setup profile: %s"
msgstr "Άγνωστο προφίλ αρχικής ρύθμισης: %s"

#: manaradix/core/setup_wizard.py:270
#, python-format
msgid ""
"The %s profile does not apply to this system: no btrfs subvolume matches its"
" policies."
msgstr ""
"Το προφίλ %s δεν μπορεί να εφαρμοστεί σε αυτό το σύστημα: κανένας υποτόμος "
"btrfs δεν αντιστοιχεί στις πολιτικές του."

#: manaradix/core/template_strings.py:18
msgid "Desktop workstation"
msgstr "Επιτραπέζιος σταθμός εργασίας"

#: manaradix/core/template_strings.py:20
msgid ""
"Daily and weekly snapshots with a boot-time recovery point, plus the GRUB "
"recovery menu — suited for a graphical workstation."
msgstr ""
"Ημερήσια και εβδομαδιαία στιγμιότυπα με σημείο ανάκτησης κατά την εκκίνηση, "
"καθώς και μενού ανάκτησης GRUB - κατάλληλο για σταθμό εργασίας με γραφικό "
"περιβάλλον."

#: manaradix/core/template_strings.py:23
msgid "Server"
msgstr "Διακομιστής"

#: manaradix/core/template_strings.py:25
msgid ""
"Frequent hourly snapshots with long retention, extra coverage for data "
"subvolumes, a boot-time recovery point and the GRUB recovery menu."
msgstr ""
"Συχνά ωριαία στιγμιότυπα με μακρά περίοδο διατήρησης, πρόσθετη κάλυψη για "
"τους υποτόμους δεδομένων, σημείο ανάκτησης κατά την εκκίνηση και μενού "
"ανάκτησης GRUB."

#: manaradix/core/template_strings.py:28
msgid "Kiosk"
msgstr "Τερματικό ειδικής χρήσης"

#: manaradix/core/template_strings.py:30
msgid ""
"Minimal setup for a single-purpose device: a snapshot at every boot with the"
