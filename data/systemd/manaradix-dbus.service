[Unit]
Description=Manaradix D-Bus service
Documentation=man:manaradix(8)
Requires=dbus.service
After=dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/manaradix dbus serve
User=root
NoNewPrivileges=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=2

# /etc, /usr and /boot are read-only; the daemon's own write locations
# are carved back in explicitly.  ProtectSystem=strict is not usable:
# btrfs restore/balance/scrub/defrag and mount() need a writable root
# mount (ioctls fail with EROFS on a read-only bind).  ProtectHome is
# safe — snapshots are browsed under /mnt, never /home, /root.
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# Writable carve-outs for the read-only locations: config, generated
# systemd units (incl. systemctl enable symlinks), the GRUB script, and
# update-grub's output.  Snapshot dirs (/.snapshots or configured
# elsewhere) and /mnt stay writable under ProtectSystem=full without
# carve-outs.
ReadWritePaths=/etc/manaradix /etc/systemd/system /etc/grub.d /boot

# Deliberately no [Install] section: the service is never enabled at
# boot.  It is activated on demand through
# /usr/share/dbus-1/system-services/org.mageia.manaradix.service, which
# forwards to systemd via SystemdService=; the bus daemon completes
# the activation itself by watching for the org.mageia.manaradix name,
# so Type=simple is sufficient (Type=dbus adds no start-ordering value
# here).
#
# PrivateDevices is NOT set: browsing/mounting snapshots of an encrypted
# root needs /dev/mapper device nodes (LUKS).
