[Unit]
Description=Manaradix snapshot disk usage collector
Documentation=man:manaradix(1)

[Service]
Type=oneshot
ExecStart=/usr/bin/manaradix usage collect
User=root
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
# The GUI and CLI run unprivileged and read usage.sqlite (and its -wal/-shm
# companions) read-only: pin the mode instead of trusting the ambient umask.
UMask=0022
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/manaradix
